# 复制为 .env 后填入私有值；不要提交真实 .env。
# PostgreSQL（推荐当前开发形态）
VIBEFLOW_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/vibeflow
# 无 PostgreSQL 的最小本地实验可改用：
# VIBEFLOW_DATABASE_URL=sqlite+aiosqlite:///./vibeflow.db

VIBEFLOW_STORAGE_BACKEND=fs
# Optional existing read-only key file. Empty preserves app/.vault_key for local use.
VIBEFLOW_VAULT_KEY_PATH=
# Optional OpenBao Transit for organization-owned model credentials.
VIBEFLOW_PROVIDER_KMS_ADDRESS=
VIBEFLOW_PROVIDER_KMS_TOKEN_FILE=
VIBEFLOW_PROVIDER_KMS_KEY_PREFIX=
VIBEFLOW_PROVIDER_KMS_MOUNT=transit
VIBEFLOW_PROVIDER_KMS_CA_FILE=
# Optional server-side dictation. Both application-local paths must be absolute.
VIBEFLOW_VOICE_TRANSCRIBER_PATH=
VIBEFLOW_VOICE_MODEL_PATH=
# Organization identity providers use a public site origin and a private JSON file.
VIBEFLOW_OIDC_PUBLIC_ORIGIN=
VIBEFLOW_OIDC_PROVIDER_FILE=
VIBEFLOW_STORAGE_FS_ROOT=./data/files
# Retained-byte inventory budgets (not atomic write reservations or disk quotas).
# S3 credentials also need bucket-versioning and object-version listing access.
VIBEFLOW_STORAGE_MEASUREMENT_TIMEOUT_SECONDS=30
VIBEFLOW_STORAGE_MEASUREMENT_MAX_ENTRIES=1000000
VIBEFLOW_STORAGE_MEASUREMENT_CONCURRENCY=4
VIBEFLOW_STORAGE_MEASUREMENT_PAGE_SIZE=1000
VIBEFLOW_RUN_DERIVE_TIMEOUT_SECONDS=300
VIBEFLOW_CASE_COPY_TIMEOUT_SECONDS=300
VIBEFLOW_VIZ_PREPARE_TIMEOUT_SECONDS=300
# 独立渲染会话的运行期限、累计输出和本地工作目录限额。0 保持既有行为。
VIBEFLOW_VIZ_SESSION_LIFETIME_SECONDS=0
VIBEFLOW_VIZ_SESSION_MAX_OUTPUT_BYTES=0
VIBEFLOW_VIZ_SESSION_WORKSPACE_LIMIT_MB=0
VIBEFLOW_TERMINAL_PREPARE_TIMEOUT_SECONDS=300
# Optional ordinary cmd/WSL limits after the shell is released. Zero keeps the existing session behavior.
VIBEFLOW_TERMINAL_SESSION_LIFETIME_SECONDS=0
VIBEFLOW_TERMINAL_SESSION_MAX_OUTPUT_BYTES=0
# Case-bound local FS and S3 staging cmd/WSL. Zero preserves the existing behavior.
# With a workspace limit, the terminal also checks NODE_STORAGE_MIN_FREE_MB.
VIBEFLOW_TERMINAL_SESSION_WORKSPACE_LIMIT_MB=0
VIBEFLOW_NODE_STORAGE_LIMIT_MB=10240
VIBEFLOW_NODE_STORAGE_MIN_FREE_MB=256
VIBEFLOW_EXECUTION_WORKSPACE_LIMIT_MB=4096
VIBEFLOW_EXECUTION_STORAGE_POLL_SECONDS=0.25
# Scan at startup and periodically; only verified owned remnants are cleaned.
VIBEFLOW_STORAGE_MAINTENANCE_ENABLED=true
VIBEFLOW_STORAGE_MAINTENANCE_INTERVAL_SECONDS=300
VIBEFLOW_PROVISION_STAGE_RETENTION_SECONDS=86400
# 0 keeps creation recovery receipts indefinitely. Claims and SQL proof always remain.
VIBEFLOW_PROVISION_HISTORY_RETENTION_DAYS=0
# Optional private CLI state base. .private-cli is created inside this base;
# leave empty for a hidden sibling of storage_fs_root. Never place it in cases.
VIBEFLOW_CODEX_STATE_ROOT=
# Optional native Windows mode: elevated or unelevated. Omit to use the installed Codex default.
# VIBEFLOW_CODEX_WINDOWS_SANDBOX=unelevated
# Active native Codex sessions per account, across API workers and runtimes.
VIBEFLOW_CODEX_CONCURRENT_SESSIONS=4
# Optional per-process wall time and combined stdout/stderr limits. 0 disables each limit.
VIBEFLOW_CODEX_SESSION_LIFETIME_SECONDS=0
VIBEFLOW_CODEX_SESSION_MAX_OUTPUT_BYTES=0
# WSL native CLI: optional Windows/UNC path to an existing Linux x86_64 ELF.
# Empty uses the Linux binary bundled beside the discovered Windows Codex.
VIBEFLOW_CODEX_WSL_PATH=
# Required for runtime=wsl: provision a native Linux directory owned by UID
# 65534, mode 0700, outside /mnt. Example: /var/lib/vibeflow-cli.
# Empty refuses WSL session admission; no implicit system setup is performed.
VIBEFLOW_CODEX_WSL_STATE_ROOT=

# 仅 VIBEFLOW_STORAGE_BACKEND=s3 时使用
VIBEFLOW_S3_ENDPOINT=http://127.0.0.1:8333
VIBEFLOW_S3_ACCESS_KEY=replace-with-s3-access-key
VIBEFLOW_S3_SECRET_KEY=replace-with-s3-secret-key
VIBEFLOW_S3_BUCKET=vibeflow
# S3 尚未覆盖完整 CAE 执行链；仅受限文件 API 测试才设为 true。
VIBEFLOW_ALLOW_PARTIAL_S3=false

VIBEFLOW_JWT_SECRET=replace-with-a-long-random-secret
VIBEFLOW_JWT_TTL_HOURS=72
VIBEFLOW_HOST=127.0.0.1
VIBEFLOW_PORT=8000
# Job leases use UTC timestamps. Expiration alone never grants takeover/replay.
# Lease: 10..3600 seconds; heartbeat: 1..600, strictly less than half the lease.
VIBEFLOW_JOB_LEASE_SECONDS=30
VIBEFLOW_JOB_HEARTBEAT_SECONDS=10
# Optional explicit runtime-to-host routing. Empty keeps existing local policy.
# Remote targets require shared PostgreSQL and S3; see docs/remote-worker-routing.md.
VIBEFLOW_JOB_EXECUTION_HOSTS={}
# Enable on a worker dedicated to this machine's host-addressed Redis queue.
VIBEFLOW_WORKER_HOST_QUEUE=false
VIBEFLOW_CORS_ORIGINS=http://localhost:5173
VIBEFLOW_RATE_LIMIT_API_PER_MINUTE=1200
VIBEFLOW_RATE_LIMIT_LLM_PER_MINUTE=120
VIBEFLOW_AUDIT_DIR=./data/audit

# Semantic Scholar 的可选服务端凭据。留空使用官方未认证额度。
VIBEFLOW_SEMANTIC_SCHOLAR_API_KEY=

# 可选 OIDC；留空禁用。redirect 必须与 IdP 注册值精确一致。
VIBEFLOW_OIDC_ISSUER=
VIBEFLOW_OIDC_CLIENT_ID=
VIBEFLOW_OIDC_CLIENT_SECRET=
VIBEFLOW_OIDC_REDIRECT_URI=http://localhost:5173/oidc/callback

# 托管网站 Sign in with ChatGPT；取得正式 client 注册后启用。
# public_origin 是浏览器访问本站的 HTTPS origin，不含路径。
# 在 OpenAI 精确注册 <public_origin>/api/v1/auth/chatgpt/callback。
VIBEFLOW_SIWC_CLIENT_ID=
VIBEFLOW_SIWC_PUBLIC_ORIGIN=
# 必须匹配注册方法：none 或 client_secret_basic，不自动降级。
VIBEFLOW_SIWC_TOKEN_AUTH_METHOD=none
VIBEFLOW_SIWC_CLIENT_SECRET=
# 同一部署的 API 实例共享强随机 JWT_SECRET（至少 32 字符）和数据库。
# 这只是网站身份登录；不会把 ID token 用作模型 API key。

# LLM API key 不放在此文件；通过应用的 provider profile 配置并加密保存。
