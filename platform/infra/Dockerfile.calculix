# Optional native CalculiX 2.23, built against the selected Linux distribution.
ARG API_IMAGE=vibeflow/api:dev
FROM ${API_IMAGE} AS build
ARG CALCULIX_SOURCE_SHA256=9c88385c10fb04f5dc6c4e98027a51bebdd8aee3920e05190d6c1dd08357d6e7
ARG SPOOLES_SOURCE_SHA256=a84559a0e987a1e423055ef4fdf3035d55b65bbe4bf915efaa1a35bef7f8c5dd
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl bzip2 make gcc gfortran perl libarpack2-dev liblapack-dev libblas-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl --fail --location --retry 3 https://www.dhondt.de/ccx_2.23.src.tar.bz2 -o ccx.tar.bz2 \
    && echo "${CALCULIX_SOURCE_SHA256}  ccx.tar.bz2" | sha256sum -c - \
    && curl --fail --location --retry 3 https://www.netlib.org/linalg/spooles/spooles.2.2.tgz -o spooles.tgz \
    && echo "${SPOOLES_SOURCE_SHA256}  spooles.tgz" | sha256sum -c - \
    && tar -xjf ccx.tar.bz2 && mkdir SPOOLES.2.2 && tar -xzf spooles.tgz -C SPOOLES.2.2 \
    && make -C SPOOLES.2.2 lib CC=gcc CFLAGS='-O2 -std=gnu89' \
    && python3 -c "from pathlib import Path; p=Path('CalculiX/ccx_2.23/src/readnewmesh.c'); s=p.read_text(); lines=s.splitlines(keepends=True); assert lines[467].strip()=='return NULL;'; lines[467]='  return;\n'; p.write_text(''.join(lines))" \
    && make -C CalculiX/ccx_2.23/src -j 4 ccx_2.23 \
       FFLAGS='-O2 -cpp -fallow-argument-mismatch' \
       LIBS='../../../SPOOLES.2.2/spooles.a -larpack -llapack -lblas -lpthread -lm -lc'
# Upstream's -v branch deliberately exits 201 after printing the version.
RUN python3 -c "import subprocess; p=subprocess.run(['CalculiX/ccx_2.23/src/ccx_2.23','-v'],capture_output=True,text=True); assert p.returncode==201 and p.stdout.strip()=='This is Version 2.23', (p.returncode,p.stdout,p.stderr)"

FROM ${API_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends libarpack2t64 libgfortran5 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/CalculiX/ccx_2.23/src/ccx_2.23 /usr/local/bin/ccx
RUN python3 -c "import subprocess; p=subprocess.run(['ccx','-v'],capture_output=True,text=True); assert p.returncode==201 and p.stdout.strip()=='This is Version 2.23', (p.returncode,p.stdout,p.stderr)"
