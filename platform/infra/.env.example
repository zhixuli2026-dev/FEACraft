# 复制为 infra/.env，填入私有值；命令显式传 --env-file infra/.env。
PG_PASSWORD=replace-with-a-private-postgres-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
WEB_ORIGIN=http://localhost:8080

# 仅在 --profile distributed 时启用；API 和 worker 必须连接同一个 Redis。
VIBEFLOW_DISTRIBUTED_JOBS=false
REDIS_PASSWORD=replace-with-a-private-redis-password

# Relative to infra/docker-compose.prod.yml. Provision once before starting API/worker.
# Existing databases require their ORIGINAL app/.vault_key, not a new key.
PROVIDER_VAULT_FILE=./secrets/provider-vault.key
# Optional docker-compose.provider-kms.yml overlay.
PROVIDER_KMS_ADDRESS=
PROVIDER_KMS_KEY_PREFIX=
PROVIDER_KMS_MOUNT=transit
PROVIDER_KMS_TOKEN_FILE=./secrets/provider-kms-token
# Optional docker-compose.oidc.yml overlay.
OIDC_PUBLIC_ORIGIN=
OIDC_PROVIDER_FILE=./secrets/oidc-providers.json

# 默认使用持久化 fs。启用 S3 时显式选择后端并打开该部署的 S3 启动开关。
VIBEFLOW_STORAGE_BACKEND=fs
VIBEFLOW_ALLOW_PARTIAL_S3=false

# API、对端副本和 worker 在 S3 模式下共用以下配置。将访问凭据填入私有 .env。
# VIBEFLOW_S3_ENDPOINT=http://seaweedfs:8333
# VIBEFLOW_S3_BUCKET=vibeflow
# VIBEFLOW_S3_REGION=us-east-1
# VIBEFLOW_S3_ACCESS_KEY=
# VIBEFLOW_S3_SECRET_KEY=

# Optional docker-compose.docker-cli.yml on a Linux API control node.
# VIBEFLOW_ACP_DOCKER_IMAGE=vibeflow/cli-worker:local
# VIBEFLOW_ACP_DOCKER_DEPLOYMENT=
# VIBEFLOW_DOCKER_CLI_STATE_DIR=/var/lib/vibeflow-cli
# VIBEFLOW_DOCKER_CLI_CLIENT=/usr/bin/docker
# VIBEFLOW_DOCKER_CLI_SOCKET=/var/run/docker.sock

# Optional session limits on a trusted Linux API with private cgroup v1 controllers.
# VIBEFLOW_VIZ_SESSION_LINUX_CPU_LIMIT_SECONDS=0
# VIBEFLOW_VIZ_SESSION_LINUX_MEMORY_LIMIT_MB=0
# VIBEFLOW_TERMINAL_SESSION_LINUX_CPU_LIMIT_SECONDS=0
# VIBEFLOW_TERMINAL_SESSION_LINUX_MEMORY_LIMIT_MB=0
# 随 --profile s3 使用 docker-compose.s3-auth.yml，指向 SeaweedFS 的私有身份配置。
# VIBEFLOW_SEAWEEDFS_IDENTITY_FILE=./secrets/seaweedfs-s3-identity.json
